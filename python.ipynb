import pandas as pd
import numpy as np

# Create England DataFrame
df_england = pd.DataFrame({
    'Name': ['Kane', 'Saka', 'Maguire'],
    'Age': [27, 19, 28]
})

# Create Italy DataFrame
df_italy = pd.DataFrame({
    'Name': ['Immobile', 'Chiesa'],
    'Age': [31, 23]
})

# Adding a new column
df_england['Associated Clubs'] = ['Tottenham', 'Arsenal', 'Man Utd']

# Concatenate DataFrames
both_teams = pd.concat([df_england, df_italy])

print("Combined DataFrame:")
print(both_teams)

# a) Filling NaN with a string
both_teams['Associated Clubs'] = (
    both_teams['Associated Clubs'].fillna('No Data Found')
)

print("\nAfter Filling NaN:")
print(both_teams)

# b) Sorting by Age
print("\nSorted by Age:")
print(both_teams.sort_values('Age'))

# c) GroupBy operation
df = pd.DataFrame({
    'UserID': ['U1', 'U2', 'U1', 'U2'],
    'Transaction': [500, 300, 200, 400]
})

print("\nSum of Transactions by UserID:")
print(df.groupby('UserID')['Transaction'].sum())

print("\nTransactions of User U1:")
print(df.groupby('UserID').get_group('U1'))
